// Firestore security rules for Thekla Links.
// Paste this whole file into Firebase console → Firestore Database → Rules, then Publish.
//
//  public/live   everything the public page shows (overrides, added events, notice, info text).
//                Anyone can read it; only admins can change it.
//  admins/{email} extra admins added in the portal. Owners (below) are always admins.
//  log/{id}      change log. Admins can add entries as themselves and read them. Nobody can edit them.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owners() {
      return ['harrison@theklabristol.co.uk', 'phoebe@theklabristol.co.uk'];
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn() && (me() in owners()
        || exists(/databases/$(database)/documents/admins/$(me())));
    }

    match /public/live {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.size() <= 12;
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow create: if isAdmin() && email == email.lower()
        && request.resource.data.addedBy == me();
      allow delete: if isAdmin() && email != me();
      allow update: if false;
    }

    match /log/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == me()
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
